# teenyOS kernel options, merged on top of `make ARCH=i386 tinyconfig`.
# Every line here is something tinyconfig leaves out that the system needs,
# or something it leaves in that we can do without.

# 32-bit code is noticeably smaller than x86_64; i486 is the baseline CPU.
CONFIG_64BIT=n
CONFIG_M486=y
CONFIG_NOHIGHMEM=y
CONFIG_HIGHMEM4G=n
CONFIG_X86_PAE=n
CONFIG_SMP=n
CONFIG_X86_LOCAL_APIC=n
CONFIG_X86_UP_APIC=n
CONFIG_X86_IO_APIC=n
CONFIG_HPET_TIMER=n
CONFIG_X86_MCE=n
CONFIG_MATH_EMULATION=n
CONFIG_VM86=n
CONFIG_X86_16BIT=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_X86_IOPL_IOPERM=n
# Load at 1 MB instead of the default 16 MB, so the machine needs only a few
# megabytes of RAM rather than more than sixteen.
CONFIG_PHYSICAL_START=0x100000
CONFIG_PHYSICAL_ALIGN=0x100000

# The whole image, initramfs included, is compressed once with xz.
CONFIG_KERNEL_XZ=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="initramfs.list"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# Userspace basics.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
# With SHMEM off, "tmpfs" mounts are served by ramfs, which is smaller.
CONFIG_SHMEM=n

# Console: VGA text + PC keyboard, and a serial port.
CONFIG_PRINTK=y
CONFIG_LOG_BUF_SHIFT=14
# Only warnings and worse reach the screen; `dmesg` still has everything.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_SERPORT=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HID_SUPPORT=n
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# No terminal emulators or remote logins, so no pseudo-terminals. The legacy
# BSD ptys alone register 512 devices and eat ~1 MB of kernel memory.
CONFIG_UNIX98_PTYS=n
CONFIG_LEGACY_PTYS=n

# Not needed by anything in the base system.
CONFIG_NET=n
CONFIG_PCI=n
CONFIG_BLOCK=n
CONFIG_DNOTIFY=n
CONFIG_INOTIFY_USER=n
CONFIG_FHANDLE=n
CONFIG_ADVISE_SYSCALLS=n
CONFIG_MEMBARRIER=n
CONFIG_KCMP=n
CONFIG_RSEQ=n
CONFIG_IO_URING=n
CONFIG_AIO=n
CONFIG_EVENTFD=n
CONFIG_SIGNALFD=n
CONFIG_EPOLL=n
CONFIG_BPF_SYSCALL=n

# APM BIOS power-off (QEMU/SeaBIOS and older PCs).
CONFIG_SUSPEND=y
CONFIG_APM=y
