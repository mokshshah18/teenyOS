# teenyOS kernel options, merged on top of `make tinyconfig` for x86_64.
# This layer alone is the "mini" build: console, keyboard, serial, RAM only.
# full.config adds what real PCs need.

CONFIG_64BIT=y
CONFIG_IA32_EMULATION=n
CONFIG_SMP=n
CONFIG_X86_5LEVEL=n
CONFIG_X86_MCE=n
CONFIG_X86_16BIT=n
CONFIG_MODIFY_LDT_SYSCALL=n
CONFIG_X86_IOPL_IOPERM=n
CONFIG_X86_KERNEL_IBT=n
CONFIG_X86_VSYSCALL_EMULATION=n
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=n
# Load low so small machines can boot it.
CONFIG_PHYSICAL_START=0x100000
CONFIG_PHYSICAL_ALIGN=0x200000

# The whole image, initramfs included, is compressed once with xz.
CONFIG_KERNEL_XZ=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="initramfs.list"
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_RD_GZIP=n
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n

# Userspace basics.
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
# With SHMEM off, "tmpfs" mounts are served by ramfs, which is smaller.
CONFIG_SHMEM=n
CONFIG_SWAP=n

# Console: VGA text + PC keyboard, and one serial port.
CONFIG_PRINTK=y
CONFIG_LOG_BUF_SHIFT=14
# Only warnings and worse reach the screen; `dmesg` still has everything.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=4
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_SERPORT=n
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# The legacy BSD ptys register 512 devices and eat ~1 MB of kernel memory.
CONFIG_LEGACY_PTYS=n
CONFIG_UNIX98_PTYS=n
CONFIG_HID_SUPPORT=n

CONFIG_NET=n
CONFIG_PCI=n
CONFIG_BLOCK=n
CONFIG_DNOTIFY=n
CONFIG_INOTIFY_USER=n
CONFIG_FHANDLE=n
CONFIG_ADVISE_SYSCALLS=n
CONFIG_MEMBARRIER=n
CONFIG_KCMP=n
CONFIG_RSEQ=n
CONFIG_IO_URING=n
CONFIG_AIO=n
CONFIG_EVENTFD=n
CONFIG_SIGNALFD=n
CONFIG_EPOLL=n
CONFIG_BPF_SYSCALL=n
