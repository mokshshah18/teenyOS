# Real hardware, on top of base.config: UEFI and BIOS boot, a graphical
# framebuffer, mouse, USB keyboards and sticks, SATA and NVMe disks, FAT.

# ACPI is not optional on modern PCs (interrupt routing, timers, power off)
# and the UEFI boot stub depends on it.
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FAN=n
CONFIG_ACPI_THERMAL=n
CONFIG_ACPI_PROCESSOR=n
CONFIG_ACPI_BUTTON=n
CONFIG_ACPI_TABLE_UPGRADE=n
CONFIG_ACPI_PRMT=n
CONFIG_ACPI_SPCR_TABLE=n
CONFIG_ACPI_REV_OVERRIDE_POSSIBLE=n
CONFIG_CPU_IDLE=n
CONFIG_THERMAL=n
CONFIG_PNP_DEBUG_MESSAGES=n
CONFIG_PERF_EVENTS_INTEL_UNCORE=n
CONFIG_PERF_EVENTS_INTEL_RAPL=n
CONFIG_PERF_EVENTS_INTEL_CSTATE=n

# The kernel is its own UEFI application: copy it to \EFI\BOOT\BOOTX64.EFI.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=n

# Graphics: whatever mode the firmware set up (VESA on BIOS, GOP on UEFI).
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONT_8x8=n

# Mice: PS/2 and USB, read through /dev/input/mice. Touchpads run in their
# basic PS/2 mode; the vendor protocol drivers are big.
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_ALPS=n
CONFIG_MOUSE_PS2_BYD=n
CONFIG_MOUSE_PS2_LOGIPS2PP=n
CONFIG_MOUSE_PS2_SYNAPTICS=n
CONFIG_MOUSE_PS2_CYPRESS=n
CONFIG_MOUSE_PS2_TRACKPOINT=n
CONFIG_MOUSE_PS2_FOCALTECH=n
CONFIG_INPUT_MOUSEDEV=y

# The desktop's terminal windows.
CONFIG_UNIX98_PTYS=y

CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=n
CONFIG_VGA_ARB=n

# Disks and partitions.
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_LOWLEVEL=n
CONFIG_SCSI_PROC_FS=n
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_PMP=n
CONFIG_ATA_VERBOSE_ERROR=n
CONFIG_ATA_FORCE=n
CONFIG_ATA_ACPI=n
CONFIG_BLK_DEV_NVME=y

# USB: all four host controller generations, sticks, keyboards and mice.
# Once a USB driver takes over the controller the BIOS stops emulating a
# PS/2 keyboard, so HID support is required, not optional.
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_DEFAULT_PERSIST=n
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# No KASLR: it only adds relocation data to the image.
CONFIG_RANDOMIZE_BASE=n

# USB sticks normally wait a second before the kernel will use them, which
# would delay finding the boot stick and saved files.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="usb-storage.delay_use=0"

# Networking: IPv4 over wired Ethernet and USB tethering from a phone.
# Wi-Fi needs firmware blobs and WPA, far beyond the size budget.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=n
CONFIG_WIRELESS=n
CONFIG_ETHTOOL_NETLINK=n
CONFIG_INET_DIAG=n
CONFIG_SYN_COOKIES=n
CONFIG_XFRM=n
CONFIG_NET_SCHED=n
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_WLAN=n
# Intel (also QEMU and VirtualBox) and Realtek, the common wired chips.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=n
CONFIG_IXGBE=n
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
# USB: phone tethering (RNDIS, CDC Ethernet, NCM) and Realtek USB adapters.
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX8817X=n
CONFIG_USB_NET_AX88179_178A=n
CONFIG_USB_NET_NET1080=n
CONFIG_USB_NET_CDC_SUBSET=n
CONFIG_USB_NET_ZAURUS=n
